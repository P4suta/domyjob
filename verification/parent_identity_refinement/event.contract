                if sorted.windows(DUPLICATE_WINDOW).any(|pair| matches!(pair, [first, second] if first == second)) { return Err(Invalid($what)); }
                Ok(Self(agents))
            }
        }
        impl From<$name> for Vec<AgentId> {
            fn from(value: $name) -> Self { value.0 }
